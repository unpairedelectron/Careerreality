modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dependency-lock"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "published-seo"

[[workflows.workflow]]
name = "dependency-lock"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run validate:dependency-lock"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "published-seo"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/career-reality run build && pnpm --filter @workspace/career-reality run verify:published-seo"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["xorg.libxcb", "xorg.libX11", "xorg.libXrandr", "xorg.libXcomposite", "xorg.libXcursor", "xorg.libXdamage", "xorg.libXi", "xorg.libXext", "xorg.libXfixes", "xorg.libXrender", "gtk3", "pango", "atk", "cairo", "gdk-pixbuf", "glib", "alsa-lib", "dbus", "gtk4", "vulkan-loader", "graphene", "icu", "libxml2", "sqlite", "libxslt", "lcms2", "libevent", "gst_all_1.gstreamer"]
