{
  "name": "@workspace/career-reality",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-pillar-guides.mjs",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "verify:aa-contrast": "node scripts/verify-aa-contrast.mjs",
    "prebuild": "node scripts/validate-question-banks.mjs && node scripts/generate-pillar-guides.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-llms-guide.mjs",
    "build": "vite build --config vite.config.ts",
    "postbuild": "node scripts/inject-static-site-meta.mjs && tsx scripts/generate-route-snapshots.ts && tsx scripts/verify-route-snapshots.ts && node scripts/generate-llms-guide.mjs --check --dist",
    "test:llms-guide": "node --test tests/llms-guide.test.mjs",
    "test:layoff-cashflow": "tsx --test tests/layoff-cashflow.test.ts",
    "verify:published-seo": "node --test tests/published-seo-report.test.mjs tests/www-to-apex-redirect.test.mjs && node scripts/verify-published-seo.mjs && node --test tests/indexed-routes.test.mjs && node scripts/verify-indexed-routes.mjs",
    "verify:published-seo:stability": "node scripts/verify-published-seo-stability.mjs",
    "verify:published-seo:stability:repeat": "node scripts/verify-published-seo-stability.mjs --runs=2",
    "verify:indexed-routes": "node scripts/verify-indexed-routes.mjs",
    "monitor:sitemap-drift": "node scripts/verify-indexed-routes.mjs",
    "test:indexed-routes": "node --test tests/indexed-routes.test.mjs",
    "test:ctc-tax": "tsx --test tests/ctc-tax.test.ts",
    "test:company-verification": "tsx --test tests/company-verification-model.test.ts",
    "check:company-verification-links": "node scripts/check-company-verification-links.mjs",
    "serve": "node scripts/serve-published.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:auth-deferral": "playwright test --config playwright.auth.config.ts",
    "test:e2e:auth-deferral:production": "VITE_E2E=false VITE_E2E_AUTH_RUNTIME=true pnpm run build && PLAYWRIGHT_AUTH_PRODUCTION=true pnpm exec playwright test --config playwright.auth.config.ts --grep \"production build\" --workers=1",
    "test:e2e:mobile-homepage:production": "VITE_E2E=false VITE_E2E_AUTH_RUNTIME=true pnpm run build && PLAYWRIGHT_AUTH_PRODUCTION=true PLAYWRIGHT_PRODUCTION=true pnpm exec playwright test tests/auth-deferral.spec.ts --grep \"production build (keeps unused route chunks off the mobile homepage|loads below-fold homepage content only when reached)\" --workers=1",
    "test:e2e:real-clerk-cross-tab": "playwright test --config playwright.real-clerk.config.ts",
    "test:e2e:batch": "node scripts/run-e2e-batch.mjs",
    "test:e2e:production": "VITE_E2E=true pnpm run build && PLAYWRIGHT_PRODUCTION=true pnpm exec playwright test --workers=2 --reporter=line",
    "verify:mobile-homepage-lighthouse": "node scripts/verify-mobile-homepage-lighthouse.mjs",
    "test:mobile-homepage-lighthouse": "node --test tests/homepage-lighthouse-results.test.mjs",
    "test:e2e:published": "PLAYWRIGHT_PUBLISHED=true PLAYWRIGHT_BASE_URL=https://careerreality.in pnpm exec playwright test tests/seo-foundations.spec.ts tests/article-visuals.spec.ts --grep \"published article\"",
    "test:published-seo-report": "node --test tests/published-seo-report.test.mjs",
    "audit:search-console-exports": "node scripts/audit-search-console-exports.mjs",
    "test:search-console-exports": "node --test tests/search-console-exports.test.mjs",
    "audit:editorial-metadata": "node scripts/audit-editorial-metadata.mjs",
    "write:needs-sme-review": "node scripts/generate-needs-sme-review.mjs",
    "migrate:question-bank-guide-fields": "node scripts/migrate-question-bank-guide-fields.mjs",
    "validate:question-banks": "node scripts/validate-question-banks.mjs",
    "check:question-bank-links": "node scripts/check-question-bank-links.mjs",
    "test:pillar-guide-metadata": "node --test tests/pillar-guide-metadata.test.mjs",
    "test:on-page-seo": "tsx --test tests/on-page-seo.test.ts",
    "audit:content": "pnpm --filter @workspace/scripts exec tsx ../artifacts/career-reality/scripts/content-quality-audit.ts",
    "audit:content:strict": "pnpm --filter @workspace/scripts exec tsx ../artifacts/career-reality/scripts/content-quality-audit.ts --strict",
    "test:content-audit": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/career-reality/tests/content-quality-audit.test.ts"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "@workspace/career-tools": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "catalog:",
    "input-otp": "^1.4.2",
    "lighthouse": "^13.6.0",
    "lucide-react": "catalog:",
    "mammoth": "^1.12.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "react": "catalog:",
    "react-day-picker": "^9.11.1",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "catalog:",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "@clerk/react": "^6.15.0",
    "@clerk/themes": "^2.4.57",
    "@playwright/test": "^1.55.0"
  }
}
