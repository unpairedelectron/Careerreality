{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "dispatch:layoff-alert": "tsx src/scripts/dispatch-layoff-alert.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:public-data-provenance": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/scripts/audit-public-data-provenance.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.66",
    "@clerk/shared": "^4.31.0",
    "@google-cloud/storage": "^8.4.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@types/busboy": "^1.5.4",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "mammoth": "^1.12.2",
    "multer": "^2.5.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
