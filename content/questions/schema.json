{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareerReality interview question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "bank", "topic", "subtopic", "level", "type", "question",
    "what_is_assessed", "short_answer", "deep_explanation",
    "strong_answer_signals", "weak_answer_signals", "common_mistakes",
    "follow_ups", "code", "references", "volatility", "versions_checked",
    "last_verified", "verification", "related", "review_status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "bank": { "enum": ["data-engineer", "data-scientist", "ai-ml-engineer", "gen-ai-engineer", "agentic-ai-engineer"] },
    "topic": { "type": "string", "minLength": 1 },
    "subtopic": { "type": "string", "minLength": 1 },
    "level": { "enum": ["L1", "L2", "L3", "L4"] },
    "type": { "enum": ["concept", "trade-off", "scenario", "debugging", "coding", "design", "behavioural-technical"] },
    "question": { "type": "string", "minLength": 12 },
    "what_is_assessed": { "type": "string", "minLength": 1 },
    "short_answer": { "type": "string", "minLength": 1 },
    "deep_explanation": { "type": "string", "minLength": 1 },
    "strong_answer_signals": { "$ref": "#/$defs/nonEmptyStrings" },
    "weak_answer_signals": { "$ref": "#/$defs/nonEmptyStrings" },
    "common_mistakes": { "$ref": "#/$defs/nonEmptyStrings" },
    "follow_ups": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "short_answer"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "short_answer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "visual_aid": {
      "type": ["object", "null"],
      "required": ["kind", "alt", "content"],
      "properties": {
        "kind": { "enum": ["diagram", "timeline", "comparison-table"] },
        "alt": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "code": {
      "type": ["object", "null"],
      "required": ["language", "sample", "executed", "output"],
      "properties": {
        "language": { "type": "string" },
        "sample": { "type": "string" },
        "executed": { "type": "boolean" },
        "output": { "type": "string" }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "publisher", "url", "retrieved_date"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "retrieved_date": { "type": "string", "format": "date" }
        }
      }
    },
    "volatility": { "enum": ["Stable", "Moderate", "Fast-moving"] },
    "versions_checked": { "type": "string", "minLength": 1 },
    "last_verified": { "type": "string", "format": "date" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources_checked", "rederivation_agreement", "rederivation_notes", "disagreements", "code_executed", "confidence"],
      "properties": {
        "sources_checked": { "$ref": "#/$defs/nonEmptyStrings" },
        "rederivation_agreement": { "type": "boolean" },
        "rederivation_notes": { "$ref": "#/$defs/nonEmptyStrings" },
        "disagreements": { "type": "array", "items": { "type": "string" } },
        "code_executed": { "enum": ["yes", "no", "n.a."] },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "related": { "type": "array", "items": { "type": "string" } },
    "review_status": { "const": "Drafted with AI assistance; code executed; sources cited; independent expert review pending" }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
